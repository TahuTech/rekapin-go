# Salin ke .env.prod lalu sesuaikan: cp .env.prod.example .env.prod
# Hindari karakter @ : / ? # di password (dipakai di DATABASE_URL).
POSTGRES_USER=rekapin
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT
POSTGRES_DB=rekapin

# Port host. APP_BIND=127.0.0.1 bila app di belakang Caddy/Nginx.
APP_PORT=8081
APP_BIND=0.0.0.0
# DB_BIND=0.0.0.0 hanya bila DB perlu diakses langsung dari luar VPS.
DB_PORT=5435
DB_BIND=127.0.0.1

# false bila diakses langsung http://IP:8081; true bila lewat HTTPS (wajib saat pakai domain).
SECURE_COOKIE=false
DB_MAX_CONNS=5
COMPANY_NAME=Nama Usaha Anda
COMPANY_INFO=Jl. Contoh No. 1, Kota · 0812-0000-0000
